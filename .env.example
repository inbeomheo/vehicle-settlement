PG_PORT=54329
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/vehicle_app
STORAGE_DIR=./storage
APP_URL=http://localhost:3000
# 미설정이면 기존 public + drizzle 유지. 배포에서는 vehicle.
# DB_SCHEMA=vehicle
STORAGE_DRIVER=local
# Vercel 기본 4MiB, 미설정 로컬은 기존 업로드 한도 유지.
# MAX_UPLOAD_BYTES=4194304
# Vercel 기본 3, 로컬 기본 10.
# PG_POOL_MAX=3
# 인증서 체인 검증 실패 때만 TLS 검증 생략.
# PG_SSL_NO_VERIFY=1
