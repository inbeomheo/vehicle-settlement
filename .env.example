PG_PORT=54329
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/vehicle_app
STORAGE_DIR=./storage
APP_URL=http://localhost:3000
# 미설정이면 기존 public + drizzle 유지. 배포에서는 vehicle.
# DB_SCHEMA=vehicle
STORAGE_DRIVER=local
# Vercel 기본 4MiB, 미설정 로컬은 기존 업로드 한도 유지.
# MAX_UPLOAD_BYTES=4194304
# Vercel 기본 3, 로컬 기본 10.
# PG_POOL_MAX=3
# 인증서 체인 검증 실패 때만 TLS 검증 생략.
# PG_SSL_NO_VERIFY=1

# 웹 푸시(선택). 세 값이 없거나 잘못되면 알림만 꺼집니다.
# 생성: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=<생성한 Public Key>
# VAPID_PRIVATE_KEY=<생성한 Private Key: 저장소에 기록 금지>
# VAPID_SUBJECT=mailto:운영자이메일@example.com
